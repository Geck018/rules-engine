{
  "name": "@geck018/rules-engine",
  "version": "0.1.0",
  "description": "Headless rules RAG: hybrid retrieval + browser NN for any rulebook. You own the UI; optional reference React shell included.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "rules",
    "rag",
    "retrieval",
    "embeddings",
    "browser-ml",
    "headless",
    "tabletop"
  ],
  "files": [
    "dist",
    "public/data",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./domains": {
      "types": "./dist/domains/index.d.ts",
      "import": "./dist/domains/index.js"
    },
    "./data/*": "./public/data/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geck018/rules-engine.git"
  },
  "homepage": "https://github.com/Geck018/rules-engine#readme",
  "bugs": {
    "url": "https://github.com/Geck018/rules-engine/issues"
  },
  "scripts": {
    "build:lib": "tsup",
    "prepare": "tsup",
    "dev": "vite",
    "lab": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "train:synth": "node training/synthesize_qa.mjs",
    "train:eval": "node training/synthesize_qa.mjs && node training/eval_retrieval.mjs",
    "train:compare": "node training/eval_compare.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "rules:ingest": "node scripts/ingest-generic.mjs",
    "rules:check": "node scripts/check-rules-updates.mjs",
    "rules:check:apply": "node scripts/check-rules-updates.mjs --apply"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@huggingface/transformers": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "credits": {
    "transformers.js": {
      "name": "@huggingface/transformers",
      "copyright": "Hugging Face",
      "license": "Apache-2.0",
      "url": "https://github.com/huggingface/transformers.js",
      "notice": "THIRD_PARTY_NOTICES.md"
    }
  }
}
